# PlayMetric Configuration

# ============================================
# EMULATOR SETTINGS
# ============================================
ANDROID_API_LEVEL=30
EMULATOR_DEVICE=pixel_4
SCREEN_WIDTH=1080
SCREEN_HEIGHT=1920
EMULATOR_MEMORY=2048
EMULATOR_CORES=4
VNC_PORT=5900
NOVNC_PORT=6080

# ============================================
# AGENT SETTINGS
# ============================================
AGENT_MODE=heuristic
# Options: random, heuristic, rl, hybrid
ACTION_INTERVAL=1.5
# Seconds between agent actions

# RL Agent Settings (if using RL mode)
RL_MODEL_PATH=/models/dqn_model.zip
RL_LEARNING_RATE=0.0003
RL_EXPLORATION_RATE=0.1
RL_GAMMA=0.99

# Action Space Configuration
ENABLE_TAP=true
ENABLE_SWIPE=true
ENABLE_BACK=true
ENABLE_HOME=false
ENABLE_MENU=true

# ============================================
# OBSERVATION SERVICE
# ============================================
SCREENSHOT_INTERVAL=1.0
# Screenshots per second
SCREENSHOT_FORMAT=png
SCREENSHOT_QUALITY=85
LOG_CAPTURE_INTERVAL=0.5

# ============================================
# CRASH DETECTOR
# ============================================
CRASH_CHECK_INTERVAL=2.0
ANR_TIMEOUT=10
# Seconds before considering app frozen
FREEZE_DETECTION=true
MEMORY_THRESHOLD=90
# Percentage

# ============================================
# ANALYTICS ENGINE
# ============================================
DIFFICULTY_THRESHOLD=0.7
RETENTION_SIMULATION_DAYS=7,30
ANALYTICS_UPDATE_INTERVAL=300
# Seconds (5 minutes)

# Level Detection
ENABLE_OCR=true
OCR_CONFIDENCE_THRESHOLD=0.8
LEVEL_KEYWORDS=Level,Stage,Round,Wave

# ============================================
# ORCHESTRATOR API
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
SESSION_TIMEOUT=3600
# Seconds (1 hour)

# ============================================
# DATA STORAGE
# ============================================
DATA_DIR=/data
SCREENSHOTS_DIR=/data/screenshots
LOGS_DIR=/data/logs
ANALYTICS_DIR=/data/analytics
MODELS_DIR=/data/models

# Retention Policy
MAX_SCREENSHOT_AGE_DAYS=7
MAX_LOG_AGE_DAYS=30
COMPRESS_OLD_DATA=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json
ENABLE_FILE_LOGGING=true
MAX_LOG_SIZE_MB=100

# ============================================
# NETWORKING
# ============================================
ADB_PORT=5555
ORCHESTRATOR_URL=http://orchestrator:8000
OBSERVATION_URL=http://observation:8001
CRASH_DETECTOR_URL=http://crash-detector:8002
ANALYTICS_URL=http://analytics:8003
AGENT_URL=http://agent:8004

# ============================================
# PERFORMANCE
# ============================================
MAX_CONCURRENT_SESSIONS=1
ENABLE_GPU=false
# Enable if you have GPU support
THREAD_POOL_SIZE=4

# ============================================
# SECURITY
# ============================================
API_KEY=changeme_in_production
ENABLE_AUTH=false
# Set to true in production

# ============================================
# DEBUGGING
# ============================================
DEBUG_MODE=false
SAVE_DEBUG_SCREENSHOTS=true
VERBOSE_LOGGING=false
ENABLE_PROFILING=false

# ============================================
# ADVANCED
# ============================================
# ADB Settings
ADB_TIMEOUT=30
ADB_RETRY_COUNT=3

# Emulator Boot Settings
BOOT_TIMEOUT=180
# Seconds to wait for emulator boot

# Network Settings
NETWORK_MODE=bridge
DNS_SERVERS=8.8.8.8,8.8.4.4

# Resource Limits
MAX_MEMORY_GB=6
MAX_CPU_PERCENT=80
