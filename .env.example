# PlayMetric Configuration - Example
# Copy this to .env and customize

# ============================================
# DEVICE SETTINGS
# ============================================
# Physical Device Setup (Recommended for accurate testing)
# 1. Enable USB Debugging on Android phone
# 2. Connect via USB to Windows PC
# 3. Run: adb devices (should show device as "device" not "unauthorized")
# 4. Run: adb tcpip 5555
# 5. Get device IP: adb shell ip addr show wlan0 | findstr inet
# 6. Run: adb connect <DEVICE_IP>:5555
# 7. Disconnect USB, device stays connected over WiFi
# 8. Set DEVICE_IP below to your device's IP address
#
# Screen dimensions are auto-detected at session start - no manual config needed
ADB_PORT=5555
USE_PHYSICAL_DEVICE=true  # Set to false for emulator
DEVICE_IP=192.168.0.80  # Your physical device IP (run 'adb devices' to find it)

# ============================================
# AI AGENT SETTINGS
# ============================================
AGENT_MODE=heuristic
# Options: random, heuristic, rl, hybrid

ACTION_INTERVAL=1.0
# Seconds between agent actions (1 second = time to analyze 16 frames and decide)

# ============================================
# OBSERVATION SERVICE
# ============================================
SCREENSHOT_INTERVAL=0.0625
# 16 FPS high-performance capture (1/16 = 0.0625 seconds)
SCREENSHOT_FPS=16
# Capture 16 frames per second for smooth analysis

# OCR Settings
ENABLE_OCR=true
OCR_CONFIDENCE_THRESHOLD=0.8

# ============================================
# ANALYTICS ENGINE
# ============================================
DIFFICULTY_THRESHOLD=0.7
RETENTION_SIMULATION_DAYS=7,30

# ============================================
# DATABASE (Railway TimescaleDB - Cloud)
# ============================================
# Using Railway managed TimescaleDB for production
# Get your database credentials from Railway dashboard
DB_USER=railway
DB_PASSWORD=your_railway_password_here
DB_HOST=your-railway-host.proxy.rlwy.net
DB_PORT=16049
DB_NAME=railway

# For services that support DATABASE_URL directly
DATABASE_URL=postgresql://railway:your_railway_password_here@your-railway-host.proxy.rlwy.net:16049/railway

# ============================================
# REDIS (Caching)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# API SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
SESSION_TIMEOUT=3600

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# ============================================
# SERVICE URLs (Internal Docker Network)
# ============================================
ORCHESTRATOR_URL=http://orchestrator:8000
OBSERVATION_URL=http://observation:8001
ANALYTICS_URL=http://analytics:8003
AGENT_URL=http://agent:8004

# ============================================
# VISION AI (Phase 2) & RL (Phase 3)
# ============================================
# Get your free API keys: https://aistudio.google.com/app/apikey
# Multiple keys for parallel processing (one per worker)
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# xAI Grok API (https://console.x.ai/) - Free tier: 25 requests/hour
# Grok Vision is excellent for game understanding and strategy
XAI_API_KEY=your_xai_api_key_here
GROK_ENABLED=false

VISION_AI_ENABLED=true
VISION_AI_MODEL=gemini-2.5-flash
VISION_AI_FREQUENCY=7
# Call Vision AI every N actions (7 = ~8-9 calls/min at 0.7s interval, well within 15 req/min free tier)

# LLaVA Local Vision Model (Optional - Unlimited FREE)
# Automatically used as fallback when Gemini unavailable or quota exceeded
# Requires ~10GB RAM, runs on CPU (slow) or GPU (fast)
# Set to true to prefer LLaVA over Gemini (privacy mode)
USE_LLAVA_FALLBACK=false

RL_ENABLED=true
RL_MODEL_PATH=/app/data/rl_model.pkl
