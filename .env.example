# PlayMetric Configuration - Example
# Copy this to .env and customize

# ============================================
# EMULATOR SETTINGS (Host Machine)
# ============================================
SCREEN_WIDTH=1080
SCREEN_HEIGHT=1920
ADB_PORT=5555

# ============================================
# AI AGENT SETTINGS
# ============================================
AGENT_MODE=heuristic
# Options: random, heuristic, rl, hybrid

ACTION_INTERVAL=1.5
# Seconds between agent actions

# ============================================
# OBSERVATION SERVICE
# ============================================
SCREENSHOT_INTERVAL=0.333
SCREENSHOT_FPS=3

# OCR Settings
ENABLE_OCR=true
OCR_CONFIDENCE_THRESHOLD=0.8

# ============================================
# ANALYTICS ENGINE
# ============================================
DIFFICULTY_THRESHOLD=0.7
RETENTION_SIMULATION_DAYS=7,30

# ============================================
# DATABASE (PostgreSQL + TimescaleDB)
# ============================================
DB_USER=playmetric
DB_PASSWORD=playmetric123
DB_HOST=postgres
DB_PORT=5432
DB_NAME=playmetric

# ============================================
# REDIS (Caching)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# API SETTINGS
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
SESSION_TIMEOUT=3600

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# ============================================
# SERVICE URLs (Internal Docker Network)
# ============================================
ORCHESTRATOR_URL=http://orchestrator:8000
OBSERVATION_URL=http://observation:8001
ANALYTICS_URL=http://analytics:8003
AGENT_URL=http://agent:8004

# ============================================
# VISION AI (Phase 2) & RL (Phase 3)
# ============================================
# Get your free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
VISION_AI_ENABLED=true
VISION_AI_MODEL=gemini-1.5-flash
RL_ENABLED=true
RL_MODEL_PATH=/app/data/rl_model.pkl
