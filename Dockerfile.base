# ===================================================================
# PAIME ULTIMATE CACHED BASE IMAGE
# This image contains ALL Python packages for ALL services
# Zero download time for any service startup! 🚀
# ===================================================================

FROM python:3.11-slim

# Configure pip to ALWAYS use cache directory
ENV PIP_CACHE_DIR=/root/.cache/pip
ENV PIP_FIND_LINKS=/root/.cache/pip

# Install only essential system dependencies used by multiple services
RUN apt-get update && apt-get install -y \
    # Essential build tools (needed for pip packages with C extensions)
    gcc \
    python3-dev \
    # Database connectivity (backend, ai_agent)
    libpq-dev \
    # Networking utilities (health checks, debugging)
    curl \
    # Image processing (pillow, opencv)
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Clean up to reduce image size
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PIP_CACHE_DIR=/root/.cache/pip

# ===================================================================
# COMMON PACKAGE INSTALLATION
# Installing ONLY packages used by 2+ services with cache
# ===================================================================

# Install ONLY common packages used by 2+ services
RUN --mount=type=cache,target=/root/.cache/pip \
    echo "🚀 Installing COMMON packages used by 2+ services..." && \
    pip install --upgrade pip setuptools wheel && \
    pip install \
        # Common web framework packages (backend, ai_agent, emulator)
        fastapi>=0.100.0 \
        "uvicorn[standard]>=0.20.0" \
        pydantic>=2.0.0 \
        # Common database packages (backend, ai_agent, emulator)
        redis>=4.5.0 \
        asyncpg>=0.29.0 \
        # Common utility packages (backend, ai_agent, emulator)
        pillow>=10.1.0 \
        websockets>=12.0 \
        aiofiles>=23.2.1 \
        python-dotenv>=0.19.0 \
        aiohttp>=3.9.1 \
        # Common development packages
        requests>=2.28.0 \
    && echo "✅ COMMON packages installed and cached!" \
    && echo "📦 Cache size: $(du -sh /root/.cache/pip/ 2>/dev/null || echo 'calculating...')" \
    && echo "🚀 Base image ready - services will add their specific packages!"
# Create a verification script
RUN echo '#!/bin/bash\necho "🔍 Verifying cached packages..."\npip list | wc -l\necho "📦 Total packages installed:"\necho "✅ Base image ready with common package cache!"' > /app/verify_cache.sh && \
    chmod +x /app/verify_cache.sh

# Display cache statistics  
RUN echo "📊 PAIME Base Image Cache Statistics:" && \
    pip list | wc -l && \
    du -sh /root/.cache/pip/ || echo "Cache size calculation..." && \
    echo "🚀 Base image ready - services will add specific packages!"
